source "https://rubygems.org"

# GitHub Pages에 그대로 올릴 경우
gem "github-pages", group: :jekyll_plugins

# 로컬에서 최신 Jekyll로 돌리고 싶다면 위 줄을 지우고 아래를 사용하세요.
# gem "jekyll", "~> 4.3"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end

platforms :mingw, :x64_mingw, :mswin, :jruby do
